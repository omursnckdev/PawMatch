rules_version = '2';

// Pet photos live at petPhotos/{ownerId}/{petId}/{fileName}. Content moderation
// (Cloud Vision SafeSearch, §7 item 4) happens after upload via a Storage
// trigger — these rules only enforce ownership and basic file constraints.
service firebase.storage {
  match /b/{bucket}/o {
    match /petPhotos/{ownerId}/{petId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == ownerId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
